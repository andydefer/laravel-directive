#!/usr/bin/env php
<?php

// bin/directive
declare(strict_types=1);

// Load environment variables from .env if available (optional)
$envFile = getcwd() . '/.env';
if (file_exists($envFile)) {
    $lines = file($envFile);
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line && !str_starts_with($line, '#')) {
            putenv($line);
        }
    }
}

// 🔥 CHARGER L'AUTOLOADER DU PROJET D'ABORD
$projectAutoload = getcwd() . '/vendor/autoload.php';
if (!file_exists($projectAutoload)) {
    fwrite(STDERR, "ERROR: Autoloader not found at {$projectAutoload}. Run 'composer install' first.\n");
    exit(1);
}
require_once $projectAutoload;

// 🔥 PUIS CHARGER L'AUTOLOADER DU PACKAGE (si différent)
$packageAutoload = __DIR__ . '/../vendor/autoload.php';
if (file_exists($packageAutoload) && $packageAutoload !== $projectAutoload) {
    require_once $packageAutoload;
}

use AndyDefer\Directive\DirectiveKernel;
use AndyDefer\Directive\Services\DirectiveExecutionService;
use AndyDefer\Directive\Services\DirectiveDiscoveryService;
use AndyDefer\Directive\Services\DirectiveHydratorService;
use AndyDefer\Directive\Services\DirectiveInteractionService;
use AndyDefer\Directive\Services\DirectiveParserService;
use AndyDefer\Directive\Services\DirectiveRendererService;
use AndyDefer\Directive\Services\DirectiveRegistrar;
use AndyDefer\Directive\Services\LaravelBootstrapper;
use AndyDefer\Directive\Services\SignatureValidationService;
use AndyDefer\Directive\Factories\ContainerDirectiveFactory;
use AndyDefer\Directive\Config\DirectiveConfig;
use AndyDefer\Directive\Tasks\InputTask;
use AndyDefer\Directive\Tasks\RenderTask;
use AndyDefer\Records\Collections\Utility\StringTypedCollection;
use Illuminate\Container\Container;

$container = new Container();

// Enregistrer les Tasks
$container->singleton(RenderTask::class, function () {
    return new RenderTask();
});
$container->singleton(InputTask::class, function () {
    return new InputTask();
});

// Enregistrer les Services
$container->singleton(DirectiveInteractionService::class, function ($c) {
    return new DirectiveInteractionService(
        $c->make(RenderTask::class),
        $c->make(InputTask::class),
    );
});

$container->singleton(SignatureValidationService::class, function () {
    return new SignatureValidationService();
});

$container->singleton(LaravelBootstrapper::class, function () {
    return new LaravelBootstrapper();
});

$projectRoot = getcwd();
$directivesPath = $projectRoot . '/app/Directives';

// Lire la configuration si elle existe
$configFile = $projectRoot . '/config/directive.php';
if (file_exists($configFile)) {
    $config = require $configFile;
    if (isset($config['path']) && is_string($config['path'])) {
        $path = $config['path'];
        if (str_starts_with($path, 'app_path()')) {
            $path = str_replace('app_path()', $projectRoot . '/app', $path);
        }
        $directivesPath = $path;
    }
}

$directiveConfig = DirectiveConfig::default()->withDirectivesPath($directivesPath);
$factory = new ContainerDirectiveFactory($container);
$parser = new DirectiveParserService();
$hydrator = new DirectiveHydratorService($factory);
$registrar = new DirectiveRegistrar();
$laravelBootstrapper = $container->make(LaravelBootstrapper::class);

// Injecter le bootstrapper dans l'hydrator
$hydrator->setLaravelBootstrapper($laravelBootstrapper);

// Enregistrer la directive make-directive
$classes = new StringTypedCollection();
$classes->add(\AndyDefer\Directive\Directives\MakeDirective::class);
$registrar->register($classes);

$discovery = new DirectiveDiscoveryService($directiveConfig, $hydrator, $registrar);
$renderer = new DirectiveRendererService($container->make(RenderTask::class));
$interaction = $container->make(DirectiveInteractionService::class);
$signatureValidator = $container->make(SignatureValidationService::class);

$executionService = new DirectiveExecutionService(
    discovery: $discovery,
    parser: $parser,
    hydrator: $hydrator,
    renderer: $renderer,
);
$executionService->setLaravelBootstrapper($laravelBootstrapper);

$kernel = new DirectiveKernel(
    $executionService,
    $signatureValidator,
    $renderer,
);

$exitCode = $kernel->run($argv);

exit($exitCode->value);
