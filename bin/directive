#!/usr/bin/env php
<?php

declare(strict_types=1);

require './vendor/autoload.php';

use AndyDefer\ConsoleWriter\Console\Console;
use AndyDefer\Directive\Bootstrap\CliBootstrap;
use AndyDefer\Directive\Exceptions\BootstrapException;

$console = new Console();

try {
    $bootstrap = CliBootstrap::create();
    $exitCode = $bootstrap->run($argv);
    exit($exitCode);
} catch (BootstrapException $e) {
    $console->error('Bootstrap Error: ' . $e->getMessage());
    exit(2);
} catch (\Throwable $e) {
    $console->error('Fatal Error: ' . $e->getMessage());
    $console->line($e->getTraceAsString());
    exit(255);
}
